# ============================================================
# SPECTER OS — Environment Variables Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── App Info ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SPECTER OS
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# ── Security & Authentication ────────────────────────────────
NEXTAUTH_SECRET=specteros_local_dev_secret_key_32_characters_minimum!
WEBHOOK_SECRET=specteros_webhook_secret_key_2026

# ── Google Gemini AI ──────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ── Mail Automation Providers (Choose any ONE) ────────────────
# 1. Resend (Recommended for Next.js - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=SPECTER OS <notifications@yourdomain.com>

# 2. SendGrid (Optional alternative - https://sendgrid.com)
# SENDGRID_API_KEY=

# 3. Brevo / Sendinblue (Optional alternative - https://brevo.com)
# BREVO_API_KEY=

# 4. Postmark (Optional alternative - https://postmarkapp.com)
# POSTMARK_SERVER_TOKEN=

# ── Meta WhatsApp Cloud API ───────────────────────────────────
# Get from Meta for Developers: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=specteros_webhook_token_2026
WHATSAPP_APP_SECRET=

# ── Optional Supabase Cloud Sync (SQLite is primary) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTkwMDAwMDAwMH0.demo_signature_for_development_mode_only_replace_in_env_local
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Feature Flags ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_TIME_TRACKING=true

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
